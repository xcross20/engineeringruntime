{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cycle evidence v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_order_id",
    "candidate_sha",
    "reviewed_sha",
    "builder_session",
    "reviewer_session",
    "checks",
    "findings",
    "controller_decision"
  ],
  "properties": {
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reviewed_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "builder_session": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_session": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "controller_decision": {
      "enum": [
        "ACCEPT",
        "CONTINUE",
        "BLOCKED",
        "RETHINK"
      ]
    }
  }
}
